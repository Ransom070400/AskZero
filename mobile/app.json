{
  "expo": {
    "name": "AskZero",
    "slug": "askzero",
    "version": "1.0.0",
    "scheme": "askzero",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.askzero.app",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AskZero uses the microphone for voice input.",
        "NSPhotoLibraryUsageDescription": "AskZero lets you attach photos to your chats."
      }
    },
    "android": {
      "package": "ai.askzero.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "26139d2d-d724-4201-bed6-7435be54174a"
      }
    },
    "owner": "ransom070"
  }
}
