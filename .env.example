# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://cocozqaswhyugfbilbxk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_5d_OPhpNmxst0GaTEAO6vw_F1qkyAhj

# 0G Compute (broker SDK)
ZERO_G_PRIVATE_KEY=0x_your_private_key
ZERO_G_CHAIN_RPC_URL=https://evmrpc.0g.ai

# 0G token spot price in USD (used to convert wholesale neuron costs).
# Update when 0G token moves materially.
ZERO_G_USD_RATE=0.50

# 0G Integrate Network proxy (mainnet, OpenAI-compatible) — for GLM 5.1 etc.
INTEGRATE_NETWORK_URL=https://compute-network-XX.integratenetwork.work/v1/proxy
INTEGRATE_NETWORK_KEY=app-sk-xxx

# Z-Image (Z.AI text-to-image). Defaults to the Integrate Network values above,
# but that proxy only serves chat completions — for image generation you must
# point Z_IMAGE_URL at Z.AI's OpenAI-compatible base directly.
# The route appends /images/generations, so set the base WITHOUT that suffix.
Z_IMAGE_URL=https://api.z.ai/api/paas/v4
Z_IMAGE_KEY=sk-xxx
Z_IMAGE_MODEL=z-image-turbo
Z_IMAGE_COST_CREDITS=100

# 0G Chain (mainnet — wallet connection, receipt anchoring)
NEXT_PUBLIC_ZERO_G_CHAIN_ID=16661
NEXT_PUBLIC_ZERO_G_RPC_URL=https://evmrpc.0g.ai
NEXT_PUBLIC_ZERO_G_EXPLORER_URL=https://chainscan.0g.ai
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id
NEXT_PUBLIC_DEPOSIT_WALLET_ADDRESS=0x_your_deposit_address
DEPOSIT_WALLET_PRIVATE_KEY=0x_your_deposit_wallet_key

# Autonomous Research — web search provider (Tavily, free tier at tavily.com)
TAVILY_API_KEY=tvly-xxx
# Optional: model for research reasoning (defaults to MEMORY_MODEL / glm-5.1-fp8)
# RESEARCH_MODEL=glm-5.1-fp8

# Admin
ADMIN_EMAILS=your@email.com

# Paystack (NGN deposits) — use pk_live_/sk_live_ in production
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx

# Stripe (USD deposits)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (Resend — optional, emails disabled without key)
RESEND_API_KEY=re_xxx
EMAIL_FROM=AskZero <noreply@askzero.ai>

# Receipt anchoring (optional — disables on-chain anchoring if unset)
# RECEIPT_REGISTRY_ADDRESS must be a registry deployed on the SAME chain that
# NEXT_PUBLIC_ZERO_G_RPC_URL points at. A registry address from another network
# has no code here, and postRoot against a codeless address silently succeeds
# without anchoring anything — the batcher now refuses to run in that state.
SUPABASE_SERVICE_ROLE_KEY=eyJ_your_service_role_key
RECEIPT_REGISTRY_ADDRESS=0x_deployed_registry
RECEIPT_BATCHER_PRIVATE_KEY=0x_batcher_wallet_key
CRON_SECRET=long_random_string
