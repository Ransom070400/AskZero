# @0glabs/0g-ts-sdk@0.3.3 pins ethers to an exact 6.13.1 peer, which our
# ethers@6.16.0 (shared with @0glabs/0g-serving-broker) doesn't satisfy. The
# versions are compatible at runtime, so accept the peer mismatch instead of
# downgrading ethers. Needed for CI/Vercel installs to resolve.
legacy-peer-deps=true
